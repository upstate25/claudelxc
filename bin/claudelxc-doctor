#!/usr/bin/env bash
# claudelxc-doctor - health check for the Antigravity CLI container.
# Exit 0 = healthy, non-zero = one or more checks failed.
LOG_TAG="[doctor]"
rc=0
check() { if eval "$2" >/dev/null 2>&1; then echo "  OK   $1"; else echo "  FAIL $1"; rc=1; fi; }
# note() is informational only — it never fails the health check. Used for
# user-actionable states (like "not logged in yet") that aren't container faults.
note()  { if eval "$2" >/dev/null 2>&1; then echo "  OK   $1"; else echo "  WARN $1"; fi; }

echo "$LOG_TAG $(date '+%Y-%m-%d %H:%M:%S %Z')"
check "agy binary present"          "command -v agy"
note  "agy reports a version"       "agy --version"
check "agy settings.json valid JSON" "python3 -m json.tool /root/.gemini/antigravity-cli/settings.json"
check "MCP config valid JSON"       "python3 -m json.tool /root/.gemini/config/mcp_config.json"
check "agentMode is auto"           "python3 -c 'import json,sys; sys.exit(json.load(open(\"/root/.gemini/antigravity-cli/settings.json\")).get(\"agentMode\")!=\"auto\")'"
note  "webapp-testing skill present" "test -f /root/.gemini/config/skills/webapp-testing/SKILL.md"
# agy has no documented non-interactive login check; this is a hint only.
note  "agy sign-in (run 'agy' over SSH if WARN; API key set counts)" "grep -q '^GEMINI_API_KEY=.' /etc/claudelxc/agy.env || ls /root/.local/share/keyrings/* >/dev/null 2>&1"
check "code-server running"         "systemctl is-active --quiet code-server@root"
check "code-server answers on :8443" "curl -ksf -o /dev/null https://127.0.0.1:8443/healthz"
check "docker daemon running"       "systemctl is-active --quiet docker"
note  "claudelxc checkout present"  "test -d /opt/claudelxc/.git"
# Parse df once; an unreadable df is a "can't tell", not a failed box.
DISK_PCT=$(df --output=pcent / 2>/dev/null | tail -1 | tr -dc 0-9)
if [ -n "$DISK_PCT" ]; then
  check "disk under 90% on /"       "[ $DISK_PCT -lt 90 ]"
else
  echo "  WARN could not read disk usage for /"
fi

if [ $rc -eq 0 ]; then echo "$LOG_TAG all checks passed"; else echo "$LOG_TAG one or more checks FAILED"; fi
exit $rc
